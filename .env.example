# ─── Firebase Admin SDK (Server-side) ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Firebase Client SDK (Frontend via Vite) ──────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── Razorpay (Payments) ───────────────────────────────────────────────────────
# Use test keys for development (rzp_test_*), live keys for production (rzp_live_*)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ─── Gemini AI (Scheme Recommendations & AI Features) ────────────────────────
GEMINI_API_KEY=AIzaSy...
VITE_GEMINI_API_KEY=AIzaSy...

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS & WebSocket ──────────────────────────────────────────────────────────
# The URL of the frontend client (used for CORS and WebSocket origin)
CLIENT_URL=http://localhost:5173

# The URL of the backend API (used by the frontend fetch client)
VITE_API_URL=http://localhost:3001/api

# The WebSocket server URL (used by frontend socket.io-client)
VITE_WS_URL=http://localhost:3001

# ─── Sentry Error Monitoring (Optional) ───────────────────────────────────────
# Leave empty to disable Sentry. Set in production for error tracking.
SENTRY_DSN=

# ─── LeanIX Integration (Optional) ───────────────────────────────────────────
LEANIX_API_KEY=
LEANIX_BASE_URL=https://app.leanix.net/services

# ─── Production Overrides ─────────────────────────────────────────────────────
# When deploying to production, set:
# NODE_ENV=production
# CLIENT_URL=https://your-production-domain.com
# VITE_API_URL=https://your-api-domain.com/api
# VITE_WS_URL=https://your-api-domain.com
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
